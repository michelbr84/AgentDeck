{
  "name": "agentdeck-monorepo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=!agentdeck-monorepo build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "clean": "pnpm -r exec rm -rf dist node_modules tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
